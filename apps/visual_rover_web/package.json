{
  "name": "@vrover/visual-rover-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VRover — the GUI agent (brain) with a Vue 3 web UI. One koa server serves the API and the SPA (Vite middleware in dev, static in prod).",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@vrover/agent": "workspace:*",
    "@vrover/config": "workspace:*",
    "@vrover/llm": "workspace:*",
    "@vrover/platform": "workspace:*",
    "koa": "^2.15.4"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5"
  }
}
