# Anthropic API key — get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-me

# Model used as the agent brain (single provider for now; pluggable layer comes later).
# Default is claude-opus-4-8. For cheaper iterative dev try claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-opus-4-8

# Reasoning effort: low | medium | high | xhigh | max (default medium)
ANTHROPIC_EFFORT=medium

# Max output tokens per LLM turn (default 16000)
ANTHROPIC_MAX_TOKENS=16000

# Max agent steps before the loop gives up
MAX_STEPS=15
